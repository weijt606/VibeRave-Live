# VibeRave — environment configuration
# Copy to .env and fill in. .env is gitignored; never commit secrets.
#
# Most users won't need to touch this — the in-app "API Settings" panel
# lets you configure provider, key, base URL, and model from the browser
# (settings live in localStorage, never persisted on the server). Values
# sent from the browser as x-llm-* headers are tried FIRST, then the
# provider chain below.

# ─── LLM provider chain ───────────────
# Comma-separated, order = priority. The API tries each in turn and fails
# over on timeout / 5xx / 429 / network error; a provider that fails twice
# in a row is skipped for 60 s, then probed again.
# Default (§45): no OpenAI. DeepSeek's own API
# first (fastest: ~9/10 booth turns inside 20 s), then DeepSeek served by
# Alibaba Cloud 百炼 (same 百炼 key as Qwen speech, thinking off), then the
# pregen library. Two different companies' servers.
# Staff can switch order / model on the console: 主控 → long-press ⚙ 设置.
# Pick another order with real numbers: pnpm --filter @viberave/api llm-smoke
# Providers without a key / model are skipped at boot (see the [llm] log line).
LLM_PROVIDERS=deepseek,bailian-deepseek

# Optional, NOT in the default order: OpenAI (may need a VPN or proxy on some networks).
# To use it, add `openai` to LLM_PROVIDERS. gpt-5+ / o-series are detected as
# reasoning models: max_completion_tokens (3× LLM_MAX_TOKENS), no temperature.
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_MODEL=gpt-5.1
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_REASONING_EFFORT=low         # none | minimal | low | medium — lower = faster
# Node does NOT follow the macOS system proxy: LLM_OPENAI_PROXY=http://127.0.0.1:7890

# Other providers (OpenAI-compatible; base URLs are preset).
LLM_DEEPSEEK_API_KEY=                     # DeepSeek official, https://platform.deepseek.com
LLM_DEEPSEEK_MODEL=deepseek-chat
# Alibaba Cloud 百炼 (https://bailian.console.aliyun.com → API-KEY). ONE key
# covers Qwen speech recognition, `bailian-deepseek` and `dashscope` (Qwen).
LLM_DASHSCOPE_API_KEY=
# bailian-deepseek: DeepSeek on 百炼. Defaults: model deepseek-v4.1-flash,
# key = LLM_DASHSCOPE_API_KEY, LLM_BAILIAN_DEEPSEEK_EXTRA_BODY={"enable_thinking":false}
# LLM_BAILIAN_DEEPSEEK_MODEL=deepseek-v4.1-flash      # or deepseek-v4-pro (slower)
# dashscope: Qwen text (measured too slow for a live turn: p50 ~58 s)
LLM_DASHSCOPE_MODEL=qwen-plus
# Qwen3 thinking models need thinking off for a fast non-streamed answer:
# LLM_DASHSCOPE_EXTRA_BODY={"enable_thinking":false}
# Kimi / GLM / Doubao / SiliconFlow: add the name to LLM_PROVIDERS and set
# the model id from the console (no default — ids change often).
# LLM_MOONSHOT_API_KEY= / LLM_MOONSHOT_MODEL=
# LLM_ZHIPU_API_KEY= / LLM_ZHIPU_MODEL= / LLM_ZHIPU_EXTRA_BODY={"thinking":{"type":"disabled"}}
# LLM_DOUBAO_API_KEY= / LLM_DOUBAO_MODEL=<endpoint or model id> / LLM_DOUBAO_EXTRA_BODY={"thinking":{"type":"disabled"}}
# LLM_SILICONFLOW_API_KEY= / LLM_SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

# Every provider also accepts LLM_<NAME>_TIMEOUT_MS / _MAX_TOKENS /
# _PARAM_STYLE (reasoning|classic) / _REASONING_EFFORT / _EXTRA_BODY / _PROXY.

# Background reachability probe: GET <base>/models every N ms. An
# unreachable provider is skipped before a visitor pays its timeout.
LLM_PROBE_INTERVAL_MS=20000               # 0 = off
LLM_PROBE_TIMEOUT_MS=4000
# Hedging: if the provider in flight has not answered after N ms, start the
# next reachable one in parallel; first answer wins, the other is cancelled.
# Set it above your primary's normal p50 (llm-smoke) or every request pays
# twice. 0 = strictly sequential.
LLM_HEDGE_MS=0

# Local fallbacks — no key needed. Ollama: `ollama pull qwen2.5:14b`.
LLM_OLLAMA_BASE_URL=http://localhost:11434/v1
LLM_OLLAMA_MODEL=qwen2.5:14b
# LM Studio: load a model in the app, then paste its identifier here
# (empty = provider skipped).
LLM_LMSTUDIO_BASE_URL=http://localhost:1234/v1
LLM_LMSTUDIO_MODEL=

# Any other name in LLM_PROVIDERS reads LLM_<NAME>_API_KEY / _BASE_URL / _MODEL,
# e.g. LLM_PROVIDERS=groq,ollama + LLM_GROQ_API_KEY / LLM_GROQ_BASE_URL / LLM_GROQ_MODEL.

# Per-provider request budget: hard timeout before the next provider is
# tried, response token cap, and how many user/assistant turn pairs of
# chat history are sent to the model.
LLM_TIMEOUT_MS=15000
LLM_MAX_TOKENS=1800
LLM_HISTORY_TURNS=6
LLM_TEMPERATURE=0.85
# Booth requests override the temperature per intent: generate 1.0 (spread
# across kits/keys/structures), tweak 0.7 (smallest edit that works). The
# value above is what the developer REPL and every non-booth call use.
# The music mode travels in the request body, not here: `mode` is
# 'adult' | 'kids' | 'pro' (the pro DJ console — harder genres, club mixing
# rules).

# ─── Pregeneration-only model (scripts/pregenerate.mjs) ─────────────────────
# The pregen batch runs offline, so it can afford a slower / stronger model
# than a live booth turn. LLM_PREGEN_MODEL swaps the model on the chain,
# LLM_PREGEN_PROVIDER narrows the chain to one provider, and
# LLM_PREGEN_MAX_TOKENS raises the completion budget — a thinking model
# (deepseek-reasoner) spends reasoning tokens out of max_tokens and returns
# EMPTY content at the live default of 1800. Unset = same model as the server.
# LLM_PREGEN_MODEL=deepseek-reasoner
# LLM_PREGEN_PROVIDER=deepseek
# LLM_PREGEN_MAX_TOKENS=6000

# ─── Legacy single-provider keys (still honoured) ───────────────────────────
# When LLM_PROVIDERS is UNSET the chain is derived from these instead, so an
# older .env keeps working: LLM_PROVIDER=api → one OpenAI-compatible
# provider; LLM_PROVIDER=ollama → one local Ollama provider.
# LLM_PROVIDER=api
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:14b

# Optional LLM cleanup pass over the STT output (~500-2000ms, off by default)
LLM_CORRECT_TRANSCRIPT=true      # ~1 s LLM pass that fixes homophones (棒碗→傍晚); recommended for the booth

# ─── Booth safety ────────────────────────────
# Shared secret for the booth. When set, /generate* and /transcribe require
# a matching `x-booth-token` header (leave empty for local dev).
BOOTH_TOKEN=
# Keys from the console's 设置 panel (long-press ⚙). The
# /admin routes only answer this machine; set a token to also require an
# `x-admin-token` header (the console asks for it once). API_ENV_FILE points
# the editor at another file (default: this repo's root .env).
BOOTH_ADMIN_TOKEN=
# API_ENV_FILE=
# Booth WebSocket room. Max phone remotes
# per room — 0 (the default) turns the phone remote off; the booth plays by
# button + mic and camera. The room used when /ws/booth has no `?room=`.
BOOTH_REMOTE_MAX=0
# Audience phones on /crowd (打 call meter, booth Wi-Fi only)
BOOTH_CROWD_MAX=200
BOOTH_ROOM_DEFAULT=main
# Per-IP sliding-window limit on /generate* (requests per minute; 0 = off).
API_RATE_LIMIT_PER_MIN=20
# Request body caps → 413. `prompt` characters / `currentCode` bytes.
# API_MAX_PROMPT_CHARS=500
# API_MAX_CODE_BYTES=20480
# Pregenerated pattern cache served by GET /pregen?mode=adult|kids|pro
# (written by `pnpm --filter @viberave/api pregenerate [--mode pro]`).
# Default services/api/data/pregen
# API_PREGEN_DIR=

# ─── STT provider ───────────────────────────────────────────────────────────
# whisper → local smart-whisper        (no network, ~700-900ms warm)
# vosk    → local closed-grammar VOSK  (~10ms, only canonical phrases —
#                                        download model first, see
#                                        services/api/README.md)
# api     → any OpenAI-compatible /audio/transcriptions endpoint
#           (OpenAI Whisper, Groq Whisper, etc.)
# dashscope → DashScope paraformer (native API)
STT_PROVIDER=whisper

# Booth: an ordered fallback chain instead. Qwen3-ASR on
# DashScope (fast, good on 中文 + English style names) first;
# local whisper takes over on a timeout / error and is always appended, so
# a dead network never stops the booth hearing visitors. A member that
# fails twice in a row is skipped for 60 s. Overrides STT_PROVIDER.
STT_PROVIDERS=dashscope,whisper
# Key: STT_DASHSCOPE_API_KEY, else LLM_DASHSCOPE_API_KEY (same Bailian account).
# STT_DASHSCOPE_API_KEY=
# STT_DASHSCOPE_MODEL=qwen3-asr-flash
# STT_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# STT_DASHSCOPE_TIMEOUT_MS=5000           # then whisper (~1 s) inside the console's 15 s

# Whisper STT (smart-whisper auto-downloads the names it knows on first use
# into ~/.smart-whisper/models)
# Default `base` is multilingual — works for English AND Chinese once the
# user enables "Chinese-English mixed input" in the API Settings panel.
# For English-only setups, base.en / small.en give a small accuracy bump.
WHISPER_MODEL=large-v3-turbo-q5_0   # booth (§29): 574 MB, ~1.1 s per take on Apple silicon, far better zh + mixed
                                   # than small (~0.3 s). Download it to ~/.smart-whisper/models (see README); small is the fallback if present.
                                   # base | small | medium | large-v3-turbo also work (multilingual, no .en suffix)
WHISPER_AUTO_LANGUAGE=zh           # how an 'auto' request decodes locally: zh = Mandarin-first (English still
                                   # comes through), auto = detect (3× slower, Mandarin or English only)
# WHISPER_LANGUAGE=en          # pin to a single language; default 'auto' detects per utterance
WHISPER_GPU=true               # Metal on macOS; CUDA on Linux

# OpenAI-compatible STT API (only used when STT_PROVIDER=api)
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# VOSK model directory (only used when STT_PROVIDER=vosk).
# Defaults to services/api/models/vosk-model-small-en-us-0.15
# Download from https://alphacephei.com/vosk/models — for the booth's
# Chinese fast-lane phrases use a zh model (vosk-model-small-cn-0.22).
# VOSK_MODEL_PATH=

# ─── API server ─────────────────────────────────────────────────────────────
API_PORT=4322
API_HOST=0.0.0.0
# Per-call audio + transcript dumps under services/api/data/stage-dumps/
# (PII! disabled by default — set to 1 only for local debugging)
API_DUMP_STAGES=

# ─── Optional Supabase backend (frontend, vite/astro `PUBLIC_*` prefix) ─────
# Set both to enable short-link sharing (`?abcd1234`) and the
# public/featured pattern lists in the website. When unset, the app
# falls back to long-hash links (`#<base64>`) and the community lists
# stay empty. Bring your own Supabase project — never reuse someone
# else's anon key.
# PUBLIC_SUPABASE_URL=
# PUBLIC_SUPABASE_ANON_KEY=

# ─── Advanced (most users won't touch these) ────────────────────────────────
# Override the upload size limit, sessions / metrics / dump file paths.
# API_MAX_BYTES=52428800
# API_SESSIONS_DIR=
# API_METRICS_FILE=
# API_DUMP_DIR=

# Whisper lazy-load idle timeout (seconds). Default ~1 day = effectively
# resident; lower to free RAM after a session.
# WHISPER_OFFLOAD_SECS=86400

# Override the DJ-vocab biasing prompt fed to whisper as initial_prompt.
# Empty → use the built-in DJ/Strudel vocab from whisper-transcriber.mjs.
# WHISPER_INITIAL_PROMPT=

# ─── LAN HTTPS (scripts/make-dev-certs.sh) ──────────────────────────────────
# Browsers only expose the microphone / camera on https or localhost. For iPads
# and phones on the booth Wi-Fi, generate a local CA + server cert once and run
# both servers with TLS; devices trust the CA from https://<host>:4321/certs/viberave-dev-ca.pem
#   scripts/make-dev-certs.sh                      # writes certs/ (gitignored)
#   VIBE_TLS_DIR=$PWD/certs npx astro dev --host 0.0.0.0 --port 4321   (in website/)
#   API_TLS_DIR=$PWD/certs pnpm --filter @viberave/api dev
# API_TLS_DIR=
