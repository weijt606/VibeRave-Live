setcps(96/60/4)
arrange(
  // intro: the tune alone on kalimba, a glockenspiel answer in the gaps
  [4, stack(
    note("<[c4 c4 g4 g4] [a4 a4 g4 ~] [f4 f4 e4 e4] [d4 d4 c4 ~]>")
      .s("kalimba").gain("0.6 0.45 0.55 0.45").attack(0.02).release(0.4).room(0.3),
    note("<~ [~ e5] ~ [~ g5]>").s("glockenspiel").gain(0.3).pan(0.7)
      .delay(0.25).delaytime(0.375).delayfeedback(0.3)
  )],
  // verse: bass and a shaker join; the last bar of every four sparkles
  [8, stack(
    note("<[c4 c4 g4 g4] [a4 a4 g4 ~] [f4 f4 e4 e4] [d4 d4 c4 ~]>")
      .s("kalimba").gain("0.6 0.45 0.55 0.45").attack(0.02).release(0.4).room(0.3)
      .lastOf(4, x => x.off(1/8, y => y.add(12).gain(0.25))),
    note("<c3 a2 f2 g2>").s("gm_acoustic_bass").gain(0.45).attack(0.02).release(0.3),
    s("shaker_large*8").gain(perlin.range(0.18, 0.3)).pan(sine.range(0.35, 0.65).slow(8)),
    note("<~ [~ e5] ~ [~ g5]>").s("glockenspiel").gain(0.3).pan(0.7)
  )],
  // break: the recorder sings the tune, harp rolls underneath
  [4, stack(
    note("<[c5 c5 g5 g5] [a5 a5 g5 ~] [f5 f5 e5 e5] [d5 d5 c5 ~]>")
      .s("recorder_alto_sus").gain(0.45).attack(0.06).release(0.3).pan(0.4),
    note("<[c3 e3 g3 c4] [a2 c3 e3 a3] [f2 a2 c3 f3] [g2 b2 d3 g3]>")
      .s("harp").gain(0.4).attack(0.02).release(0.6).room(0.45)
      .lpf(sine.range(1200, 4000).slow(8))
  )],
  // finale: everyone, the tune doubled an octave up, a soft clap on 2 and 4
  [8, stack(
    note("<[c4 c4 g4 g4] [a4 a4 g4 ~] [f4 f4 e4 e4] [d4 d4 c4 ~]>")
      .s("kalimba").gain("0.6 0.45 0.55 0.45").attack(0.02).release(0.4).room(0.3)
      .jux(x => x.add(12).gain(0.3)),
    note("<c3 a2 f2 g2>").s("gm_acoustic_bass").gain(0.45).attack(0.02).release(0.3),
    s("shaker_large*8").gain(perlin.range(0.18, 0.3)).degradeBy(0.1),
    s("~ clap ~ clap").gain(0.25).lastOf(4, x => x.ply(2)),
    note("<[c5,e5] [a4,c5] [f4,a4] [g4,b4]>").s("recorder_alto_sus").gain(0.3).attack(0.1).release(0.5)
  )]
)
