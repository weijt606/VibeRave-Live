---
// /stage — crowd-facing big screen for the booth. No REPL, no audio:
// it only listens to BroadcastChannel('viberave-stage') from /booth.
// Preview alone with /stage?demo=1 (live loop) or /stage?demo=attract.
import '../styles/booth-theme.css';
import '../styles/compliance.css';
import '../styles/game.css';
import '../styles/stage-hardstock.css';
import '../styles/stage-daylight.css';
import { StageView } from '../booth/stage/StageView.jsx';
---

<html lang="zh-CN" data-phase="night" data-mode="adult">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#4B3FD8" />
    <meta name="robots" content="noindex" />
    <title>VibeRave · Stage</title>
    <link rel="stylesheet" href="/fonts/booth/booth-fonts.css" />
  </head>
  <body>
    <StageView client:only="react" />
  </body>
</html>

<style is:global>
  /* /stage — poster look (CONTRACTS.md §23). One bright palette for every
     phase: blue-violet → pink → amber, white type, the program as a big
     code wall, a dark terminal card, a white waveform.
     Target: an 85" 4K TV (3840×2160, panel ≈ 188×106 cm). The overlay is a
     1920×1080 design scaled ×2, so 1 design px ≈ 1 mm on the glass; nothing
     the visitor must read is under 20 px (≈ 2 cm, legible from ~5 m) and
     the 96 px side margins keep 5 % clear of TV overscan. */
  html,
  body {
    margin: 0;
    height: 100%;
    background: #4b3fd8;
    overflow: hidden;
  }
  body {
    font-family: 'Noto Sans SC', 'PingFang SC', 'Hiragino Sans GB', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    cursor: none;
  }
  * {
    box-sizing: border-box;
  }

  .vb-stage {
    --st-display: 'Unbounded', 'Noto Sans SC', sans-serif;
    --st-body: 'Noto Sans SC', 'PingFang SC', 'Hiragino Sans GB', system-ui, sans-serif;
    --st-mono: 'JetBrains Mono', 'SF Mono', 'Menlo', monospace;
    --st-ink: #ffffff;
    --st-ink-2: rgba(255, 255, 255, 0.82);
    --st-cap: rgba(255, 255, 255, 0.66);
    --st-navy: #17154a;
    --st-card: rgba(23, 21, 74, 0.88);
    --st-gold: #8cf0cf;
    --st-lilac: #e7b8f0;
    --st-rose: #ff9fb8;
    --st-coral: #ff6f8e;
    --st-amber: #ffb84d;
    position: fixed;
    inset: 0;
    overflow: hidden;
    color: var(--st-ink);
    font-family: var(--st-body);
    background: #4b3fd8;
  }
  /* The drift moves an oversized static layer with transform, so it stays
     on the compositor instead of repainting 4K every frame. */
  .st-sky {
    position: absolute;
    inset: -12%;
    z-index: 0;
    background: linear-gradient(120deg, #3d4bff 0%, #7b4dff 32%, #ff6f8e 68%, #ffb84d 100%);
    will-change: transform;
    animation: st-sky 40s ease-in-out infinite alternate;
  }
  @keyframes st-sky {
    from {
      transform: translate3d(-4%, -3%, 0);
    }
    to {
      transform: translate3d(4%, 3%, 0);
    }
  }
  /* Faint CRT scanlines — the "terminal" in the hacker look. */
  .st-scan {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: repeating-linear-gradient(
      0deg,
      rgba(20, 10, 60, 0.06) 0 1px,
      transparent 1px calc(3px * var(--st-scale, 1))
    );
  }
  .st-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* §33: the hands draw over everything (the camera panel included) —
     they are hairlines and dots, and they are the show in 手势 mode. */
  .vb-stage .st-canvas.st-pose {
    z-index: 6;
    pointer-events: none;
  }

  /* ── code wall (§14.2 / §23.2) ─────────────────────────────────────── */
  .st-codefield {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    gap: calc(60px * var(--st-scale, 1));
    padding: 0 calc(40px * var(--st-scale, 1));
    pointer-events: none;
    user-select: none;
    overflow: hidden;
    opacity: 0.2;
  }
  .st-codefield.is-attract {
    opacity: 0.17;
  }
  .st-cf-col {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    height: 100%;
    overflow: hidden;
  }
  .st-cf-scroll {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    will-change: transform;
    animation: st-cf-drift var(--cf-dur, 80s) linear infinite;
    animation-delay: var(--cf-delay, 0s);
  }
  .st-cf-pre {
    margin: 0;
    font-family: var(--st-mono);
    font-weight: 500;
    font-size: calc(26px * var(--st-scale, 1));
    line-height: 1.5;
    white-space: pre;
    color: #fff;
  }
  .st-cf-pre .tk-str,
  .st-cf-pre .tk-call {
    font-weight: 700;
  }
  .st-cf-pre .tk-comment {
    font-style: italic;
  }
  .st-cf-line {
    display: block;
  }
  /* New code flashes up to full white for a moment — the wall "receives" it. */
  .st-cf-line.is-changed {
    animation: st-cf-glow 2.4s ease-out 1 both;
  }
  .st-cf-line.is-blink {
    opacity: 0.2;
  }
  @keyframes st-cf-drift {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-50%);
    }
  }
  @keyframes st-cf-glow {
    0%,
    30% {
      text-shadow:
        0 0 14px #fff,
        0 0 2px #fff;
    }
    100% {
      text-shadow: none;
    }
  }

  /* ── design-space overlay: 1920×1080 scaled to fit ─────────────────── */
  .st-ui {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    width: var(--st-w, 1920px);
    height: var(--st-h, 1080px);
    transform: translate(-50%, -50%) scale(var(--st-scale, 1));
    transform-origin: center;
    pointer-events: none;
  }
  .st-cap {
    font-family: var(--st-mono);
    font-size: 18px;
    letter-spacing: 0.16em;
    color: var(--st-cap);
    white-space: nowrap;
  }
  .st-cap-sm {
    font-size: 15px;
  }
  .st-cap-warm {
    color: var(--st-gold);
  }

  .st-head {
    position: absolute;
    left: 96px;
    right: 96px;
    top: 56px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .st-identity {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .st-brand {
    font: 800 46px/1 var(--st-display);
    letter-spacing: -0.02em;
    text-shadow: 0 6px 30px rgba(40, 20, 140, 0.35);
  }
  .st-head-right {
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .st-ailabel .vb-ailabel-tag {
    font-size: 16px;
    color: #fff;
    border-color: rgba(255, 255, 255, 0.7);
  }
  .st-ailabel .vb-ailabel-text {
    font-size: 20px;
    color: var(--st-ink-2);
  }
  .st-mode {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 12px 24px 12px 18px;
    border-radius: 999px;
    border: 2px solid rgba(255, 255, 255, 0.85);
    font: 700 26px/1 var(--st-body);
    background: rgba(23, 21, 74, 0.18);
  }
  /* §30.1: the badge is a button — a click switches like a tap of the key. */
  button.st-mode {
    white-space: nowrap;
    color: inherit;
    cursor: pointer;
    pointer-events: auto;
    user-select: none;
  }
  button.st-mode:active {
    transform: scale(0.97);
  }
  .st-mode.is-gesture {
    background: #fff;
    color: var(--st-navy);
  }
  .st-mode-sub {
    font-weight: 400;
    font-size: 20px;
    opacity: 0.75;
    margin-left: 4px;
  }

  /* ── the pill: what was said / what to do ──────────────────────────── */
  .st-pill {
    display: inline-flex;
    align-items: center;
    gap: 26px;
    max-width: 100%;
    padding: 16px 48px 16px 16px;
    border-radius: 999px;
    background: #fff;
    color: var(--st-navy);
    box-shadow: 0 24px 60px rgba(40, 20, 120, 0.28);
    /* §30.1: hold the pill = hold the button */
    pointer-events: auto;
    cursor: pointer;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease;
  }
  .st-pill.is-holding {
    transform: scale(1.02);
    box-shadow:
      0 0 0 6px rgba(255, 255, 255, 0.35),
      0 24px 60px rgba(40, 20, 120, 0.32);
  }
  /* §30.2: the voice while held — the wave, with a short line beside it */
  .st-pill-live {
    display: flex;
    align-items: center;
    gap: 24px;
    min-width: 640px;
  }
  .st-pill-wave {
    display: block;
    flex: none;
    width: 460px;
    height: 76px;
  }
  .st-pill-live-text {
    font: 700 38px/1.2 var(--st-body);
    color: var(--st-coral);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .st-pill-mic {
    flex: none;
    display: grid;
    place-items: center;
    width: 88px;
    height: 88px;
    border-radius: 50%;
    color: #fff;
    background: linear-gradient(135deg, var(--st-coral), var(--st-amber));
  }
  .st-pill-text {
    font: 700 48px/1.2 var(--st-body);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    transition: opacity 0.6s;
  }
  .st-pill-text.is-fade {
    opacity: 0;
  }
  .st-pill.is-long .st-pill-text {
    font-size: 38px;
  }
  .st-pill.is-hint .st-pill-text {
    color: #6a6790;
  }
  .st-pill.is-listening .st-pill-mic {
    animation: st-listen 1.1s ease-in-out infinite;
  }
  .st-pill.is-error .st-pill-mic {
    background: #2a2760;
  }
  @keyframes st-listen {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(255, 111, 142, 0.55);
    }
    50% {
      box-shadow:
        0 0 0 18px rgba(255, 111, 142, 0.18),
        0 0 0 36px rgba(255, 184, 77, 0.08);
    }
  }

  /* ── attract ───────────────────────────────────────────────────────── */
  .st-attract {
    position: absolute;
    left: 0;
    right: 0;
    top: 170px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .st-title {
    font: 800 210px/1 var(--st-display);
    letter-spacing: -0.03em;
    text-shadow: 0 10px 50px rgba(40, 20, 140, 0.35);
  }
  .st-slogan {
    margin-top: 30px;
    font: 700 46px/1.45 var(--st-body);
    text-shadow: 0 4px 24px rgba(40, 20, 140, 0.45);
  }
  .st-slogan-en {
    font-family: var(--st-display);
    font-size: 0.92em;
    letter-spacing: -0.01em;
  }
  .st-attract .st-pill {
    margin-top: 56px;
  }
  .st-attract .st-pill-text {
    font-size: 52px;
    min-width: 780px;
    text-align: left;
  }
  /* §38: the keyboard field — hidden until a key is pressed. The hint
     line sits in the text column (never on the music strip); the field is
     dark glass like the code card, above the strip. */
  .st-typer-hint {
    margin: 14px 0 0 12px;
    font: 400 22px/1 var(--st-body);
    color: var(--st-cap);
    letter-spacing: 0.04em;
  }
  .st-typer-hint.is-attract {
    margin: 18px 0 0;
    font-size: 26px;
  }
  .st-typer {
    position: absolute;
    left: 50%;
    bottom: 330px;
    z-index: 8;
    transform: translateX(-50%);
    transition: opacity 0.2s ease;
    display: flex;
    align-items: center;
    gap: 22px;
    width: 1240px;
    max-width: calc(100% - 128px);
    padding: 20px 36px;
    border-radius: 999px;
    background: rgba(23, 21, 74, 0.58);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    box-shadow: 0 24px 60px rgba(30, 15, 90, 0.3);
    pointer-events: auto;
  }
  .st-typer-cap {
    flex: none;
    font: 700 22px/1 var(--st-body);
    letter-spacing: 0.16em;
    color: var(--st-gold);
  }
  .st-typer-input {
    flex: 1;
    min-width: 0;
    border: 0;
    outline: 0;
    background: transparent;
    font: 500 42px/1.2 var(--st-body);
    color: #fff;
    caret-color: var(--st-gold);
  }
  .st-typer-input::placeholder {
    color: rgba(255, 255, 255, 0.42);
    font-weight: 400;
  }
  .st-typer-key {
    flex: none;
    font: 400 20px/1 var(--st-mono);
    color: rgba(255, 255, 255, 0.5);
  }
  /* always mounted (it holds the keyboard focus); invisible while empty */
  .st-typer.is-idle {
    opacity: 0;
    pointer-events: none;
  }
  .st-typer.is-sent {
    width: auto;
    padding: 18px 40px;
  }
  .st-typer-sent {
    font: 500 30px/1.2 var(--st-body);
    color: #fff;
  }
  .is-portrait .st-typer {
    width: 952px;
    bottom: 540px;
  }
  .st-howto {
    margin-top: 34px;
    font: 400 30px/1 var(--st-body);
    color: var(--st-ink-2);
  }
  .st-howto b {
    color: #fff;
    font-weight: 700;
    margin-right: 8px;
  }
  .st-sep {
    margin: 0 22px;
    opacity: 0.6;
  }
  .st-turnline {
    margin-top: 18px;
    font-size: 24px;
    color: var(--st-cap);
  }
  /* §55: right-hand column of the attract view: 上一位 card, then the crowd
     card. Starts under the wordmark, ends above the music strip. */
  .st-attract-side {
    position: absolute;
    right: 64px;
    top: 215px;
    width: 380px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 14px;
  }
  .st-attract-crowd {
    position: static;
    display: flex;
    justify-content: center;
  }

  /* ── live: left column (pill, status, now playing) ─────────────────── */
  .st-left {
    position: absolute;
    left: 96px;
    top: 210px;
    width: 860px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .st-status {
    margin: 26px 0 0 12px;
    font: 500 30px/1.3 var(--st-body);
    color: var(--st-ink-2);
  }
  /* §63 a one-off tip card (双击按钮，进入手势模式), top centre under the
     header, clear of the pill column and the code card */
  .st-tip {
    position: absolute;
    left: 50%;
    top: 114px;
    z-index: 6;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 18px;
    padding: 12px 34px;
    border-radius: 999px;
    background: var(--st-card);
    box-shadow:
      0 20px 60px rgba(30, 15, 90, 0.45),
      inset 0 0 0 2px var(--st-gold);
    color: var(--st-gold);
    font: 600 34px/1.2 var(--st-body);
    white-space: nowrap;
    animation: st-tip-in 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2) both;
  }
  @keyframes st-tip-in {
    from {
      opacity: 0;
      transform: translate(-50%, -16px) scale(0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .st-tip {
      animation: none;
    }
  }
  .st-status.is-notice {
    display: inline-block;
    padding: 10px 22px;
    border-radius: 999px;
    background: rgba(23, 21, 74, 0.55);
    color: #fff;
  }
  .st-now {
    margin-top: 40px;
    display: flex;
    align-items: baseline;
    gap: 36px;
  }
  .st-now-style {
    font: 800 88px/1 var(--st-display);
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-shadow: 0 6px 30px rgba(40, 20, 140, 0.3);
    /* §25: a long style name must not wrap down into the waveform */
    max-width: 1100px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .st-now-bpm {
    font: 700 56px/1 var(--st-mono);
  }
  .st-now-bpm span {
    margin-left: 10px;
    font-size: 24px;
    opacity: 0.75;
  }
  .st-explain {
    margin-top: 26px;
    max-width: 820px;
    font: 400 26px/1.5 var(--st-body);
    color: var(--st-ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .st-turn {
    margin-top: 30px;
    display: flex;
    align-items: baseline;
    gap: 22px;
    max-width: 860px;
    font: 500 26px/1.2 var(--st-body);
  }
  .st-turn-clock {
    font: 800 54px/1 var(--st-display);
  }
  .st-turn-clock small {
    margin-left: 6px;
    font: 500 22px/1 var(--st-body);
  }
  .st-turn.is-warn .st-turn-clock {
    color: var(--st-gold);
  }
  .st-turn-count {
    font-family: var(--st-mono);
    white-space: nowrap;
  }
  .st-turn-next {
    color: var(--st-ink-2);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ── live: right column (code card) ────────────────────────────────── */
  .st-right {
    position: absolute;
    right: 96px;
    top: 190px;
    width: 820px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  /* Never down into the music strip, however long the code (§33). */
  .st-cc {
    max-height: 590px;
    overflow: hidden;
    border-radius: 28px;
    background: var(--st-card);
    box-shadow: 0 30px 70px rgba(30, 15, 90, 0.38);
    padding: 30px 38px 34px;
    font-family: var(--st-mono);
    color: #fff;
  }
  .st-cc-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 18px;
    font-size: 20px;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.55);
  }
  .st-cc-status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--st-gold);
    font-family: var(--st-body);
    letter-spacing: 0.04em;
  }
  .st-cc-status.is-live {
    font-family: var(--st-mono);
    color: rgba(255, 255, 255, 0.7);
  }
  .st-cc-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--st-gold);
    animation: st-blink 0.9s steps(2, start) infinite;
  }
  .st-cc-body {
    font-size: 23px;
    line-height: 1.6;
  }
  .st-cc-line {
    white-space: pre;
    min-height: 1.6em;
    padding-left: 14px;
    border-left: 3px solid transparent;
  }
  .st-cc-line.is-changed {
    border-left-color: var(--st-gold);
    background: linear-gradient(90deg, rgba(140, 240, 207, 0.12), transparent 70%);
  }
  .st-cc-line.is-typing {
    clip-path: inset(0 100% 0 0);
    animation: st-type 0.34s steps(26, end) forwards;
    animation-delay: calc(var(--i, 0) * 90ms);
  }
  @keyframes st-type {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  .st-cc-caret {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    margin-left: 4px;
    vertical-align: -0.2em;
    background: var(--st-gold);
    animation: st-blink 1s steps(2, start) infinite;
  }
  @keyframes st-blink {
    to {
      opacity: 0.15;
    }
  }
  .tk-str {
    color: var(--st-gold);
  }
  .tk-method {
    color: var(--st-lilac);
  }
  .tk-num {
    color: var(--st-rose);
  }
  .tk-comment {
    color: rgba(255, 255, 255, 0.55);
  }
  .st-cc.is-writing .tk-comment {
    color: #fff;
  }

  /* ── gesture mode: four hints in the left column ─────────────────── */
  .st-gestures {
    margin-top: 30px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    max-width: 860px;
  }
  .st-gesture-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 12px;
    padding: 14px 26px;
    border-radius: 999px;
    background: rgba(23, 21, 74, 0.35);
    border: 1.5px solid rgba(255, 255, 255, 0.5);
    font-size: 24px;
    color: var(--st-ink-2);
  }
  .st-gesture-chip b {
    color: #fff;
    font-size: 28px;
  }
  .st-gesture-chip.is-live {
    background: #fff;
    color: var(--st-navy);
    font-weight: 700;
  }

  /* ── §32 gesture panel: the camera on the big screen ─────────────────
     Always mounted (the camera stays warm); 说话 ⇄ 手势 crossfades it with
     the code card. */
  .st-right {
    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }
